# ==============================================================================
# Zacma Dealership & Multi-Industry SaaS — Production & Local Environment Config
# ==============================================================================

# ------------------------------------------------------------------------------
# CORE APPLICATION SETTINGS (REQUIRED IN VERCEL)
# ------------------------------------------------------------------------------
APP_NAME="Zacma Dealership & Marketplace"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-project.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Logging (stderr routes logs directly to Vercel Function Logs)
LOG_CHANNEL=stderr
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# VERCEL SERVERLESS RUNTIME SETTINGS
# ------------------------------------------------------------------------------
# In serverless functions, cookie session driver encrypts sessions into the browser cookie,
# enabling seamless stateless scaling across multiple lambda invocations.
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cache driver for serverless: array (in-memory per request) or database/redis
CACHE_STORE=array

# Writable paths (automatically handled by api/index.php and vercel.json)
APP_STORAGE=/tmp/storage
LARAVEL_STORAGE_PATH=/tmp/storage
VIEW_COMPILED_PATH=/tmp/storage/framework/views
APP_CONFIG_CACHE=/tmp/config.php
APP_SERVICES_CACHE=/tmp/services.php
APP_PACKAGES_CACHE=/tmp/packages.php
APP_ROUTES_CACHE=/tmp/routes.php
APP_EVENTS_CACHE=/tmp/events.php

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Option A (Default for instant zero-config testing): Embedded SQLite
# The pre-seeded database/starter.sqlite will be copied to /tmp/database.sqlite
DB_CONNECTION=sqlite
# DB_DATABASE=/tmp/database.sqlite

# Option B (Recommended for Production): External PostgreSQL (e.g. Neon, Supabase, AWS RDS)
# DB_CONNECTION=pgsql
# DB_HOST=your-neon-or-postgres-host.com
# DB_PORT=5432
# DB_DATABASE=zacma_production
# DB_USERNAME=your_db_user
# DB_PASSWORD=your_db_password
# DB_SSLMODE=require

# Option C: External MySQL / PlanetScale / AWS RDS MySQL
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=zacma_production
# DB_USERNAME=your_db_user
# DB_PASSWORD=your_db_password

# ------------------------------------------------------------------------------
# STORAGE & QUEUES
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

# ------------------------------------------------------------------------------
# OPTIONAL REDIS (Upstash, AWS ElastiCache)
# ------------------------------------------------------------------------------
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# ------------------------------------------------------------------------------
# MAIL SETTINGS
# ------------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="info@zacma.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# ETHIOPIAN PAYMENT GATEWAYS CONFIGURATION
# ------------------------------------------------------------------------------
# 1. Chapa Gateway (Cards, Telebirr, CBEBirr)
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-xxxxxxxxxxxx
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxxxxxx
CHAPA_WEBHOOK_SECRET=your_webhook_secret_key

# 2. Telebirr Direct (Ethio Telecom API)
TELEBIRR_APP_ID=your_telebirr_app_id
TELEBIRR_APP_KEY=your_telebirr_app_key
TELEBIRR_SHORT_CODE=100123
TELEBIRR_PUBLIC_KEY=your_telebirr_public_key

# 3. Commercial Bank of Ethiopia (CBE Birr API)
CBE_MERCHANT_ID=your_cbe_merchant_id
CBE_API_KEY=your_cbe_api_key

# 4. eBirr Mobile Payment API
EBIRR_MERCHANT_ID=your_ebirr_client_id
EBIRR_API_KEY=your_ebirr_api_key

# 5. SantimPay Gateway API
SANTIMPAY_MERCHANT_ID=your_santimpay_merchant_id
SANTIMPAY_PRIVATE_KEY=your_santimpay_private_key

# ------------------------------------------------------------------------------
# FRONTEND VITE VARIABLES
# ------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
