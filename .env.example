APP_NAME="Zacma Dealership & Multi-Industry SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database Configuration (PostgreSQL / MySQL / SQLite)
DB_CONNECTION=sqlite
# For PostgreSQL:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=zacma_dealership
# DB_USERNAME=postgres
# DB_PASSWORD=your_password

SESSION_DRIVER=database
SESSION_LIFETIME=120

FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# Redis Cache & Queue
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="info@zacma.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================
# ETHIOPIAN PAYMENT GATEWAYS CONFIGURATION
# ==========================================

# 1. Chapa Gateway (Cards, Telebirr, CBEBirr)
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-xxxxxxxxxxxx
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxxxxxx
CHAPA_WEBHOOK_SECRET=your_webhook_secret_key

# 2. Telebirr Direct (Ethio Telecom API)
TELEBIRR_APP_ID=your_telebirr_app_id
TELEBIRR_APP_KEY=your_telebirr_app_key
TELEBIRR_SHORT_CODE=100123
TELEBIRR_PUBLIC_KEY=your_telebirr_public_key

# 3. Commercial Bank of Ethiopia (CBE Birr API)
CBE_MERCHANT_ID=your_cbe_merchant_id
CBE_API_KEY=your_cbe_api_key

# 4. eBirr Mobile Payment API
EBIRR_MERCHANT_ID=your_ebirr_client_id
EBIRR_API_KEY=your_ebirr_api_key

# 5. SantimPay Gateway API
SANTIMPAY_MERCHANT_ID=your_santimpay_merchant_id
SANTIMPAY_PRIVATE_KEY=your_santimpay_private_key
