APP_NAME="Zacma Marketplace SaaS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Addis_Ababa
APP_URL=https://zacma.yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# MySQL Database on cPanel
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpaneluser_zacma
DB_USERNAME=cpaneluser_dbuser
DB_PASSWORD=your_secure_db_password

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=zacma_cache

MEMCACHED_HOST=127.0.0.1

# SMTP Mail Settings on cPanel
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=465
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# AI Service Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Ethiopian Payment Gateways
SANTIMPAY_MERCHANT_ID=
SANTIMPAY_PRIVATE_KEY=
SANTIMPAY_ENV=live

TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_SHORT_CODE=
TELEBIRR_ENV=live

CHAPA_SECRET_KEY=
CHAPA_PUBLIC_KEY=

# Global Payment Gateways
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=live

STRIPE_KEY=
STRIPE_SECRET=
